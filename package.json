{
  "name": "farocapital-monorepo",
  "private": true,
  "scripts": {
    "dev": "lerna run dev",
    "build": "lerna run build",
    "typecheck": "lerna run typecheck",
    "dev:webapp": "lerna run dev --scope \"@farocapital/webapp\" --scope \"@farocapital/utils\" --scope \"@farocapital/pdf-templates\"",
    "build:webapp": "lerna run build --scope \"@farocapital/webapp\" --scope \"@farocapital/utils\" --scope \"@farocapital/pdf-templates\" --scope \"@farocapital/sdk-ts\"",
    "dev:server": "lerna run dev --scope \"@farocapital/server\" --scope \"@farocapital/utils\" --scope \"@farocapital/pdf-templates\" --scope \"@farocapital/email-components\"",
"build:shared": "lerna run build --scope \"@farocapital/utils\" --scope \"@farocapital/pdf-templates\" --scope \"@farocapital/email-components\" --scope \"@farocapital/sdk-ts\"",
    "build:server": "lerna run build --scope \"@farocapital/server\" --scope \"@farocapital/utils\" --scope \"@farocapital/pdf-templates\" --scope \"@farocapital/email-components\"",
    "serve:server": "lerna run serve --scope \"@farocapital/server\" --scope \"@farocapital/utils\"",
    "server:start": "lerna run start:dev --scope \"@farocapital/server\"",
    "test:watch": "lerna run test:watch",
    "test:e2e": "lerna run test:e2e",
    "e2e:webapp": "playwright test",
    "start:debug": "lerna run start:debug",
    "prepare": "husky install",
    "system:migrate:make": "lerna run cli:system:migrate:make --scope \"@farocapital/server\"",
    "tenants:migrate:make": "lerna run cli:tenants:migrate:make --scope \"@farocapital/server\"",
    "system:migrate:rollback": "lerna run cli:system:migrate:rollback --scope \"@farocapital/server\"",
    "tenants:migrate:rollback": "lerna run cli:tenants:migrate:rollback --scope \"@farocapital/server\"",
    "system:migrate:latest": "lerna run cli:system:migrate:latest --scope \"@farocapital/server\"",
    "tenants:migrate:latest": "lerna run cli:tenants:migrate:latest --scope \"@farocapital/server\"",
    "system:seed:latest": "lerna run cli:system:seed:latest --scope \"@farocapital/server\"",
    "tenants:seed:latest": "lerna run cli:tenants:seed:latest --scope \"@farocapital/server\"",
    "generate:sdk-types": "lerna run openapi:export --scope \"@farocapital/server\" && lerna run generate --scope \"@farocapital/sdk-ts\" && lerna run build --scope \"@farocapital/sdk-ts\"",
    "format": "lerna run format",
    "format:check": "lerna run format:check",
    "lint": "lerna run lint",
    "lint:check": "lerna run lint:check",
    "qa:spain": "node scripts/qa-spain-phase10.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@commitlint/config-lerna-scopes": "^17.4.2",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "^1.32.3",
    "husky": "^8.0.3",
    "lerna": "^8.1.2",
    "pnpm": "^9.0.5"
  },
  "engines": {
    "node": "16.x || 17.x || 18.x"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "tsup": "^8.3.0"
  }
}
